	partition activity_sleep = m
		mode: import
		source =
				let
				    Source = Table.NestedJoin(sleep_cleaned, {"Id", "SleepDay"}, daily_activity_cleaned, {"Id", "ActivityDate"}, "daily_activity_cleaned", JoinKind.Inner),
				    #"Expanded daily_activity_cleaned" = Table.ExpandTableColumn(Source, "daily_activity_cleaned", {"TotalSteps", "VeryActiveMinutes", "FairlyActiveMinutes", "LightlyActiveMinutes", "SedentaryMinutes", "Calories"}, {"TotalSteps", "VeryActiveMinutes", "FairlyActiveMinutes", "LightlyActiveMinutes", "SedentaryMinutes", "Calories"})
				in
