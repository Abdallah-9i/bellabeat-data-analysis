table activity_sleep
	lineageTag: 5a0ad65f-6dd9-4651-b69e-2a5394b2102d

	measure 'Sleep Hours' = ```
			
			DIVIDE(
			    SUM('activity_sleep'[TotalMinutesAsleep]),
			    60
			)
			
			```
		lineageTag: a06b4dcf-e9a0-4a74-856b-e590e7b03b79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sedentary Hours' = ```
			
